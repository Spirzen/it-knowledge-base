{
  "name": "it-knowledge-base",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "npm run docs:wiki-links && npm run docs:search-index && cross-env NODE_OPTIONS=--max-old-space-size=12288 docusaurus start",
    "build": "npm run docs:collection-titles && npm run docs:wiki-links && npm run docs:search-index && cross-env NODE_OPTIONS=--max-old-space-size=12288 docusaurus build",
    "docs:search-index": "node scripts/build-doc-search-index.mjs",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "cross-env NODE_OPTIONS=--max-old-space-size=12288 docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "docs:demo-registry": "node scripts/generate-demo-registry.mjs",
    "docs:collection-titles": "node scripts/generate-collection-doc-titles.mjs",
    "docs:collection-crosslinks": "node scripts/enrich-collection-crosslinks.mjs",
    "docs:wiki-links": "node scripts/build-wiki-link-index.mjs",
    "docs:toc": "node scripts/generate-toc.mjs",
    "docs:fix-mdx-imports": "node scripts/fix-mdx-import-after-frontmatter.mjs",
    "docs:fix-frontmatter-blank": "node scripts/fix-blank-after-frontmatter.mjs",
    "docs:fix-heading-separators": "node scripts/fix-heading-separators.mjs",
    "docs:basics-crosslinks": "node scripts/enrich-basics-crosslinks.mjs",
    "docs:lab-crosslinks": "node scripts/enrich-lab-crosslinks.mjs",
    "docs:revert-basics-wiki": "node scripts/revert-basics-wiki-markup.mjs",
    "docs:fix-cyrillic-latin": "node scripts/fix-cyrillic-latin-corruption.mjs",
    "docs:trailing-hr": "node scripts/ensure-article-trailing-hr.mjs",
    "docs:normalize-tags": "node scripts/normalize-article-tags.mjs",
    "docs:descriptions": "node scripts/ensure-article-descriptions.mjs",
    "docs:refine-descriptions": "node scripts/refine-article-descriptions.mjs",
    "docs:dotnet-catalog": "node scripts/generate-dotnet-reference-catalog.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/faster": "^3.10.0",
    "@docusaurus/preset-classic": "^3.10.0",
    "@docusaurus/theme-live-codeblock": "^3.10.0",
    "@docusaurus/theme-mermaid": "^3.10.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "konva": "^9.3.22",
    "prism-react-renderer": "^2.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.2.4",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.0",
    "@docusaurus/plugin-client-redirects": "^3.10.0",
    "@docusaurus/types": "^3.10.0",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
